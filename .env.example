# Copy this to .env and fill in values before deploying locally
# In Dokploy, set these in the Environment Variables tab instead.

PORT=3000

# IMPORTANT: Change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Path where the SQLite database file is stored (inside the persistent volume)
DB_PATH=/data/crm.db
